<?xml version="1.0" encoding="iso-8859-1"?>
<project>
  <fileVersion>3</fileVersion>
  <configuration>
    <name>Debug</name>
    <toolchain>
      <name>RL78</name>
    </toolchain>
    <debug>1</debug>
    <settings>
      <name>General</name>
      <data>
        <option>
          <name>GenDeviceSelect</name>
          <state>R5F10WMG	RL78 - R5F10WMG</state>
        </option>
        <option>
          <name>GenRTConfigPath</name>
          <state>$TOOLKIT_DIR$\LIB\dlrl78fnd22n.h</state>
        </option>
      </data>
    </settings>
    <settings>
      <name>ICCRL78</name>
      <data>
        <option>
          <name>CCDefines</name>
          <state>_CODE_DEBUG_</state>
          <state>USE_ASSERT</state>
        </option>
        <option>
          <name>CCIncludePath2</name>
          <state>$PROJ_DIR$\..\Code</state>
          <state>$PROJ_DIR$\..\Code\bsp</state>
          <state>$PROJ_DIR$\..\Code</state>
          <state></state>
        </option>
        <option>
          <name>PreInclude</name>
          <state></state>
        </option>
        <option>
          <name>IccUseExtraOptions</name>
          <state>0</state>
        </option>
        <option>
          <name>IccExtraOptions</name>
          <state>--nonsense</state>
        </option>
      </data>
    </settings>
  </configuration>
  <configuration>
    <name>Release</name>
    <toolchain>
      <name>RL78</name>
    </toolchain>
    <debug>0</debug>
    <settings>
      <name>General</name>
      <data>
        <option>
          <name>GenDeviceSelect</name>
          <state>R5F10WMG	RL78 - R5F10WMG</state>
        </option>
      </data>
    </settings>
    <settings>
      <name>ICCRL78</name>
      <data>
        <option>
          <name>CCDefines</name>
          <state>DEF_RELEASE</state>
        </option>
        <option>
          <name>CCIncludePath2</name>
          <state>$PROJ_DIR$\..\Code</state>
        </option>
        <option>
          <name>IccUseExtraOptions</name>
          <state>1</state>
        </option>
        <option>
          <name>IccExtraOptions</name>
          <state>--no_cse</state>
        </option>
      </data>
    </settings>
  </configuration>
  <group>
    <name>app</name>
    <file>
      <name>$PROJ_DIR$\..\Code\main.c</name>
    </file>
    <file>
      <name>$PROJ_DIR$\..\Code\debug_only.c</name>
      <excluded>
        <configuration>Release</configuration>
      </excluded>
    </file>
    <file>
      <name>$PROJ_DIR$\..\Code\api.h</name>
    </file>
    <group>
      <name>bsp</name>
      <file>
        <name>$PROJ_DIR$\..\Code\bsp\board.c</name>
      </file>
    </group>
  </group>
</project>
